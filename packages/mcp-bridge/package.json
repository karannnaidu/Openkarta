{
  "name": "@openkarta/mcp-bridge",
  "version": "0.5.0",
  "description": "OpenKarta MCP bridge — exposes the OpenKarta agent registry as MCP tools to MCP-aware hosts (Claude Desktop, MCP-aware editors).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openkarta/openkarta.git",
    "directory": "packages/mcp-bridge"
  },
  "homepage": "https://github.com/openkarta/openkarta/tree/main/packages/mcp-bridge#readme",
  "engines": { "node": ">=22.0.0" },
  "publishConfig": { "access": "public" },
  "bin": { "openkarta-mcp": "./dist/bin.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@openkarta/spec": "workspace:*",
    "@openkarta/orchestrator": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.0"
  }
}
