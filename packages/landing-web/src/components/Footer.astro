---
const year = new Date().getFullYear();
---
<footer class="bg-surface-container-lowest border-t border-on-background/10 transition-transform duration-240">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 max-w-[1440px] mx-auto w-full py-20 px-8 md:px-16">
    <div class="sm:col-span-2 flex flex-col gap-4">
      <a href="/" class="flex items-center gap-3 group w-fit">
        <img src="/logo.png" alt="OpenKarta" class="ok-logo-img h-11 w-11 group-hover:rotate-[8deg]" />
        <span class="font-hero-h1 text-2xl tracking-tight text-on-background">OpenKarta</span>
      </a>
      <p class="font-code-block text-xs uppercase tracking-widest text-on-surface-variant">© {year} OpenKarta — open contract for agentic commerce. MIT-licensed.</p>
    </div>
    <div class="flex flex-col gap-3">
      <div class="font-label-caps text-label-caps text-on-background uppercase">Protocol</div>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/protocol">Specification</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/conformance">Conformance</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/merchant">For merchants</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/manifest">Manifest example</a>
    </div>
    <div class="flex flex-col gap-3">
      <div class="font-label-caps text-label-caps text-on-background uppercase">Build</div>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/developers">Developers</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/registry">Registry</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="https://registry.openkarta.org">Hosted registry ↗</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="https://github.com/karannnaidu/Openkarta">GitHub ↗</a>
    </div>
    <div class="flex flex-col gap-3">
      <div class="font-label-caps text-label-caps text-on-background uppercase">Foundation</div>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/governance">Governance</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/charter">Neutrality charter</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/manifesto">Manifesto</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/about">About</a>
    </div>
    <div class="flex flex-col gap-3">
      <div class="font-label-caps text-label-caps text-on-background uppercase">More</div>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/blog">Blog</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/changelog">Changelog</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/press">Press kit</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/status">Status</a>
    </div>
  </div>
  <div class="border-t border-on-background/10">
    <div class="max-w-[1440px] mx-auto w-full py-6 px-8 md:px-16 flex flex-col md:flex-row justify-between gap-4 text-sm">
      <div class="flex gap-6 text-on-surface-variant">
        <a class="hover:text-on-background transition-colors duration-240" href="/security">Security</a>
        <a class="hover:text-on-background transition-colors duration-240" href="/privacy">Privacy</a>
        <a class="hover:text-on-background transition-colors duration-240" href="/terms">Terms</a>
      </div>
      <div class="font-code-block text-xs text-on-surface-variant">api.openkarta.org · registry.openkarta.org</div>
    </div>
  </div>
</footer>
