---
interface Props {
  lang?: string;
  filename?: string;
  inline?: boolean;
  class?: string;
}
const { lang, filename, inline = false, class: extra = "" } = Astro.props;
const hasHeader = Boolean(filename || lang);
---
{inline ? (
  <code class:list={["ok-inline-code font-code-block text-code-block bg-black text-white px-1.5 py-0.5 border border-inverse-surface", extra]}><slot /></code>
) : (
  <div class:list={["ok-codeblock relative border border-inverse-surface bg-black text-white", extra]}>
    {hasHeader ? (
      <div class="flex items-center justify-between border-b border-inverse-on-surface/10 px-4 py-2 gap-4 bg-on-background/30">
        <span class="font-code-block text-code-block text-inverse-on-surface/80 truncate">
          {filename}
          {filename && lang && <span class="text-inverse-on-surface/40"> · </span>}
          {lang && <span class="font-label-caps text-label-caps uppercase">{lang}</span>}
        </span>
        <button
          type="button"
          class="ok-copy shrink-0 inline-flex items-center gap-1 px-2 py-1 text-inverse-on-surface/70 hover:text-inverse-on-surface transition-colors"
          aria-label="Copy code to clipboard"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M5 1.75A1.75 1.75 0 0 1 6.75 0h6.5A1.75 1.75 0 0 1 15 1.75v6.5A1.75 1.75 0 0 1 13.25 10H11v2.25A1.75 1.75 0 0 1 9.25 14h-6.5A1.75 1.75 0 0 1 1 12.25v-6.5A1.75 1.75 0 0 1 2.75 4H5V1.75ZM6.5 4h2.75A1.75 1.75 0 0 1 11 5.75V8.5h2.25a.25.25 0 0 0 .25-.25v-6.5a.25.25 0 0 0-.25-.25h-6.5a.25.25 0 0 0-.25.25V4ZM2.75 5.5a.25.25 0 0 0-.25.25v6.5c0 .138.112.25.25.25h6.5a.25.25 0 0 0 .25-.25v-6.5a.25.25 0 0 0-.25-.25h-6.5Z"/>
          </svg>
          <span class="ok-copy-label font-label-caps text-label-caps uppercase">Copy</span>
        </button>
      </div>
    ) : (
      <button
        type="button"
        class="ok-copy absolute top-2 right-2 z-10 inline-flex items-center gap-1 px-2 py-1 text-inverse-on-surface/70 hover:text-inverse-on-surface bg-inverse-surface/95 transition-colors"
        aria-label="Copy code to clipboard"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
          <path d="M5 1.75A1.75 1.75 0 0 1 6.75 0h6.5A1.75 1.75 0 0 1 15 1.75v6.5A1.75 1.75 0 0 1 13.25 10H11v2.25A1.75 1.75 0 0 1 9.25 14h-6.5A1.75 1.75 0 0 1 1 12.25v-6.5A1.75 1.75 0 0 1 2.75 4H5V1.75ZM6.5 4h2.75A1.75 1.75 0 0 1 11 5.75V8.5h2.25a.25.25 0 0 0 .25-.25v-6.5a.25.25 0 0 0-.25-.25h-6.5a.25.25 0 0 0-.25.25V4ZM2.75 5.5a.25.25 0 0 0-.25.25v6.5c0 .138.112.25.25.25h6.5a.25.25 0 0 0 .25-.25v-6.5a.25.25 0 0 0-.25-.25h-6.5Z"/>
        </svg>
        <span class="ok-copy-label font-label-caps text-label-caps uppercase sr-only">Copy</span>
      </button>
    )}
    <pre class="font-code-block text-code-block text-inverse-on-surface overflow-x-auto p-4 m-0 bg-transparent"><code><slot /></code></pre>
  </div>
)}
