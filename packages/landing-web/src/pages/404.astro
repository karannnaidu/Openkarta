---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found — OpenKarta" activeNav={null}>
  <section class="max-w-[1440px] mx-auto px-8 md:px-16 mt-20 mb-32">
    <div class="font-label-caps text-label-caps text-on-surface-variant uppercase mb-8">404 · resource not found</div>
    <h1 class="font-hero-h1 text-on-background [font-size:clamp(48px,8vw,108px)] leading-[1.05] tracking-tight max-w-5xl">
      No such verb.
    </h1>
    <p class="font-h2-editorial text-on-surface-variant mt-8 max-w-3xl">
      The protocol has eight verbs. This URL is not one of them. Try one of these instead.
    </p>
  </section>

  <section class="max-w-[1440px] mx-auto px-8 md:px-16 mb-32">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-on-background/10">
      {[
        { href: '/', label: '/', desc: 'Landing' },
        { href: '/protocol', label: '/protocol', desc: 'Specification' },
        { href: '/developers', label: '/developers', desc: 'Build with OpenKarta' },
        { href: '/registry', label: '/registry', desc: 'Live agent listings' },
        { href: '/conformance', label: '/conformance', desc: 'Signed badges' },
        { href: '/merchant', label: '/merchant', desc: 'List your store' },
        { href: '/charter', label: '/charter', desc: 'Neutrality charter' },
        { href: '/status', label: '/status', desc: 'System health' },
      ].map((l) => (
        <a class="border border-on-background/10 bg-surface-container-lowest p-8 hover-lift block" href={l.href}>
          <div class="font-code-block text-code-block text-on-background mb-2">{l.label}</div>
          <div class="font-body-dense text-body-dense text-on-surface-variant">{l.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-[1440px] mx-auto px-8 md:px-16 mb-32">
    <div class="border border-on-background/10 bg-surface-container-lowest p-10">
      <div class="font-label-caps text-label-caps uppercase text-on-surface-variant mb-3">Error envelope</div>
      <pre class="font-code-block text-code-block text-on-background overflow-x-auto"><code>{`{
  "code":    "not_found",
  "message": "No resource at this URL.",
  "agentId": "openkarta-org",
  "ts":      ${Date.now()}
}`}</code></pre>
    </div>
  </section>
</BaseLayout>
