---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'protocol' | 'merchant' | 'governance' | 'developers' | 'manifesto' | null;
}

const {
  title,
  description = 'OpenKarta — The open contract for agentic commerce.',
  activeNav = null,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Serif:wght@400;500&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
<script is:inline>
  tailwind = {
    config: {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#003ec7',
            'on-primary': '#ffffff',
            'primary-container': '#0052ff',
            'on-primary-container': '#dfe3ff',
            'inverse-primary': '#b7c4ff',
            'primary-fixed': '#dde1ff',
            'primary-fixed-dim': '#b7c4ff',
            'on-primary-fixed': '#001452',
            'on-primary-fixed-variant': '#0038b6',
            secondary: '#5f5e5e',
            'on-secondary': '#ffffff',
            'secondary-container': '#e5e2e1',
            'on-secondary-container': '#656464',
            'secondary-fixed': '#e5e2e1',
            'secondary-fixed-dim': '#c9c6c5',
            'on-secondary-fixed': '#1c1b1b',
            'on-secondary-fixed-variant': '#474646',
            tertiary: '#4c4e4f',
            'on-tertiary': '#ffffff',
            'tertiary-container': '#656666',
            'on-tertiary-container': '#e4e4e5',
            'tertiary-fixed': '#e2e2e2',
            'tertiary-fixed-dim': '#c6c6c7',
            'on-tertiary-fixed': '#1a1c1c',
            'on-tertiary-fixed-variant': '#454747',
            error: '#ba1a1a',
            'on-error': '#ffffff',
            'error-container': '#ffdad6',
            'on-error-container': '#93000a',
            background: '#fbf9f9',
            'on-background': '#1b1c1c',
            surface: '#fbf9f9',
            'on-surface': '#1b1c1c',
            'surface-dim': '#dbdad9',
            'surface-bright': '#fbf9f9',
            'surface-container-lowest': '#ffffff',
            'surface-container-low': '#f5f3f3',
            'surface-container': '#efeded',
            'surface-container-high': '#e9e8e7',
            'surface-container-highest': '#e3e2e2',
            'surface-variant': '#e3e2e2',
            'on-surface-variant': '#434656',
            'surface-tint': '#004ced',
            'inverse-surface': '#303031',
            'inverse-on-surface': '#f2f0f0',
            outline: '#737688',
            'outline-variant': '#c3c5d9',
          },
          spacing: {
            'margin-page': '64px',
            'container-max': '1440px',
            'section-gap': '160px',
            unit: '4px',
            gutter: '24px',
          },
          fontFamily: {
            'hero-h1': ['"Noto Serif"', 'serif'],
            'display-lg': ['Inter', 'sans-serif'],
            'h2-editorial': ['Inter', 'sans-serif'],
            'body-main': ['Inter', 'sans-serif'],
            'body-dense': ['Inter', 'sans-serif'],
            'label-caps': ['Inter', 'sans-serif'],
            'code-block': ['"JetBrains Mono"', 'monospace'],
          },
          fontSize: {
            'hero-h1': ['120px', { lineHeight: '1.1', letterSpacing: '-0.02em', fontWeight: '400' }],
            'display-lg': ['64px', { lineHeight: '1.1', letterSpacing: '-0.03em', fontWeight: '600' }],
            'h2-editorial': ['32px', { lineHeight: '1.2', letterSpacing: '-0.02em', fontWeight: '500' }],
            'body-main': ['16px', { lineHeight: '1.6', letterSpacing: '0em', fontWeight: '400' }],
            'body-dense': ['14px', { lineHeight: '1.4', letterSpacing: '0em', fontWeight: '400' }],
            'label-caps': ['11px', { lineHeight: '1.0', letterSpacing: '0.1em', fontWeight: '600' }],
            'code-block': ['13px', { lineHeight: '1.5', letterSpacing: '0em', fontWeight: '400' }],
          },
          borderRadius: { DEFAULT: '0', sm: '0', md: '0', lg: '0', xl: '0', full: '9999px' },
        },
      },
    },
  };
</script>
<script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<style is:global>
  body { font-family: Inter, system-ui, sans-serif; }
  pre { white-space: pre; }
  pre code { display: block; white-space: pre; font-family: 'JetBrains Mono', monospace; }
  .hover-lift {
    transition: transform 240ms cubic-bezier(0.2, 0, 0, 1),
                border-color 240ms cubic-bezier(0.2, 0, 0, 1),
                box-shadow 240ms cubic-bezier(0.2, 0, 0, 1);
  }
  .hover-lift:hover {
    transform: translateY(-4px);
    border-color: rgba(27, 28, 28, 1);
    box-shadow: 0 10px 30px -20px rgba(27, 28, 28, 0.4);
  }
  .fade-slide-up {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 240ms cubic-bezier(0.2, 0, 0, 1),
                transform 240ms cubic-bezier(0.2, 0, 0, 1);
  }
  .fade-slide-up.visible { opacity: 1; transform: translateY(0); }
  .ok-link { position: relative; }
  .ok-link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px;
    height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left center;
    transition: transform 280ms cubic-bezier(0.2, 0, 0, 1);
  }
  .ok-link:hover::after { transform: scaleX(1); }
  .ok-arrow { display: inline-block; transition: transform 240ms cubic-bezier(0.2,0,0,1); }
  .ok-arrow-host:hover .ok-arrow { transform: translate(2px, -2px); }
  .ok-pulse { position: relative; }
  .ok-pulse::after {
    content: ''; position: absolute; inset: 0; border-radius: 9999px;
    background: currentColor; opacity: 0.6;
    animation: okpulse 1.6s cubic-bezier(0.2,0,0,1) infinite;
  }
  @keyframes okpulse {
    0%   { transform: scale(1); opacity: 0.5; }
    70%  { transform: scale(2.4); opacity: 0; }
    100% { transform: scale(2.4); opacity: 0; }
  }
  .ok-cursor::after {
    content: '▍'; display: inline-block; margin-left: 2px;
    animation: okblink 1s steps(2,end) infinite; color: currentColor;
  }
  @keyframes okblink { 50% { opacity: 0; } }
  .header-shrunk { height: 64px !important; backdrop-filter: blur(16px); }
  .header-shrunk .ok-logo-img { height: 32px; width: 32px; }
  .ok-logo-img { transition: height 240ms cubic-bezier(0.2,0,0,1), width 240ms cubic-bezier(0.2,0,0,1); }
  .diagram-node { border: 1px solid #1b1c1c; }
  .diagram-line { background-color: #1b1c1c; }
  .diagram-highlight { background-color: #0052FF; border-color: #0052FF; color: white; }
  .mono-diagram-line { stroke: currentColor; stroke-width: 1; fill: none; }
  .mono-diagram-highlight { stroke: #0052FF; stroke-width: 2; fill: rgba(0, 82, 255, 0.1); }
  @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  @keyframes marquee-reverse { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }
  .animate-marquee { animation: marquee 60s linear infinite; }
  .animate-marquee-reverse { animation: marquee-reverse 80s linear infinite; }
  .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
  @media (prefers-reduced-motion: reduce) {
    .fade-slide-up { opacity: 1; transform: none; }
    .animate-marquee, .animate-marquee-reverse, .ok-pulse::after, .ok-cursor::after { animation: none !important; }
    .ok-link::after { transition: none; }
  }
</style>
</head>
<body class="bg-surface-container-lowest text-on-background font-body-main antialiased selection:bg-primary-container selection:text-on-primary">
<Header activeNav={activeNav} />
<main class="pt-20"><slot /></main>
<Footer />
<script type="module">
  import { animate, inView, stagger } from 'https://cdn.jsdelivr.net/npm/motion@10.18.0/+esm';
  window.__ok = window.__ok || {};
  window.__ok.motion = { animate, inView, stagger };
  window.dispatchEvent(new Event('ok:motion-ready'));
</script>
<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Baseline reveal — always works even if Motion One CDN fails.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-slide-up').forEach((el) => io.observe(el));

    // Header shrink-on-scroll
    const header = document.querySelector('header[data-ok-header]');
    if (header) {
      const onScroll = () => {
        if (window.scrollY > 24) header.classList.add('header-shrunk');
        else header.classList.remove('header-shrunk');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    // Helpers exposed on window.__ok — page scripts call these.
    const ok = (window.__ok = window.__ok || {});
    ok.reduced = reduced;

    ok.staggerIn = function (selector, opts) {
      opts = opts || {};
      const els = typeof selector === 'string' ? document.querySelectorAll(selector) : selector;
      if (!els || !els.length) return;
      const m = window.__ok.motion;
      if (reduced || !m) {
        els.forEach((el) => { el.style.opacity = 1; el.style.transform = 'none'; });
        return;
      }
      els.forEach((el) => { el.style.opacity = '0'; el.style.transform = 'translateY(16px)'; });
      m.inView(els[0], () => {
        m.animate(
          els,
          { opacity: 1, transform: 'translateY(0px)' },
          { duration: 0.4, delay: m.stagger(opts.stagger || 0.06), easing: [0.2, 0, 0, 1] }
        );
      }, { margin: '-10% 0px' });
    };

    ok.countUp = function (el, target, duration) {
      duration = duration || 1.2;
      const m = window.__ok.motion;
      if (reduced || !m) { el.textContent = String(target); return; }
      m.inView(el, () => {
        const start = performance.now();
        const from = 0;
        const tick = (t) => {
          const k = Math.min(1, (t - start) / (duration * 1000));
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = String(Math.round(from + (target - from) * eased));
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };

    ok.typeOut = function (el, opts) {
      opts = opts || {};
      const speed = opts.charsPerSec || 200;
      const original = el.textContent;
      const m = window.__ok.motion;
      if (reduced || !m) return;
      el.textContent = '';
      el.classList.add('ok-cursor');
      m.inView(el, () => {
        let i = 0;
        const start = performance.now();
        const total = original.length;
        const tick = (t) => {
          const elapsed = (t - start) / 1000;
          const target = Math.min(total, Math.floor(elapsed * speed));
          if (target > i) { el.textContent = original.slice(0, target); i = target; }
          if (i < total) requestAnimationFrame(tick);
          else setTimeout(() => el.classList.remove('ok-cursor'), 600);
        };
        requestAnimationFrame(tick);
      });
    };

    // Auto-apply data attributes
    const wireAuto = () => {
      document.querySelectorAll('[data-ok-stagger]').forEach((parent) => {
        const sel = parent.getAttribute('data-ok-stagger') || ':scope > *';
        const delay = parseFloat(parent.getAttribute('data-ok-stagger-delay') || '0.06');
        ok.staggerIn(parent.querySelectorAll(sel), { stagger: delay });
      });
      document.querySelectorAll('[data-ok-count]').forEach((el) => {
        const target = parseInt(el.getAttribute('data-ok-count') || '0', 10);
        ok.countUp(el, target);
      });
      document.querySelectorAll('[data-ok-typeout]').forEach((el) => {
        const speed = parseInt(el.getAttribute('data-ok-typeout') || '200', 10);
        ok.typeOut(el, { charsPerSec: speed });
      });
    };

    if (window.__ok.motion) wireAuto();
    else window.addEventListener('ok:motion-ready', wireAuto, { once: true });
  })();
</script>
</body>
</html>
