---
const year = new Date().getFullYear();
---
<footer class="bg-surface-container-lowest border-t border-on-background/10">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 max-w-[1440px] mx-auto w-full py-16 px-8 md:px-16">
    <div class="sm:col-span-2 flex flex-col gap-4">
      <a href="/" class="flex items-center gap-3 group w-fit">
        <img src="/logo.png" alt="" class="ok-logo-img h-[64px] w-[64px] group-hover:rotate-[8deg]" />
        <span class="flex flex-col leading-tight">
          <span class="font-hero-h1 text-xl tracking-tight text-on-background">OpenKarta</span>
          <span class="font-label-caps text-label-caps uppercase text-on-surface-variant">Registry</span>
        </span>
      </a>
      <p class="font-code-block text-xs uppercase tracking-widest text-on-surface-variant">© {year} OpenKarta — neutral, MIT-licensed registry of conformant agents.</p>
    </div>
    <div class="flex flex-col gap-3">
      <div class="font-label-caps text-label-caps text-on-background uppercase">Registry</div>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/">Browse</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/submit">Submit an agent</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/me">My agents</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="/sign-in">Sign in</a>
    </div>
    <div class="flex flex-col gap-3">
      <div class="font-label-caps text-label-caps text-on-background uppercase">Project</div>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="https://openkarta.org">openkarta.org ↗</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="https://openkarta.org/protocol">Specification ↗</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="https://openkarta.org/conformance">Conformance ↗</a>
      <a class="text-on-surface-variant hover:text-on-background transition-colors duration-240 text-sm" href="https://github.com/karannnaidu/Openkarta">GitHub ↗</a>
    </div>
  </div>
  <div class="border-t border-on-background/10">
    <div class="max-w-[1440px] mx-auto w-full py-6 px-8 md:px-16 flex flex-col md:flex-row justify-between gap-4 text-sm">
      <div class="flex gap-6 text-on-surface-variant">
        <a class="hover:text-on-background transition-colors duration-240" href="https://openkarta.org/governance">Governance</a>
        <a class="hover:text-on-background transition-colors duration-240" href="https://openkarta.org/security">Security</a>
        <a class="hover:text-on-background transition-colors duration-240" href="https://openkarta.org/privacy">Privacy</a>
        <a class="hover:text-on-background transition-colors duration-240" href="https://openkarta.org/terms">Terms</a>
      </div>
      <div class="font-code-block text-xs text-on-surface-variant">api.openkarta.org · registry.openkarta.org</div>
    </div>
  </div>
</footer>
