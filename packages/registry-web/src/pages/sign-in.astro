---
import BaseLayout from '../layouts/BaseLayout.astro';
const apiBase = import.meta.env.PUBLIC_API_BASE ?? 'https://registry.openkarta.org';
---
<BaseLayout title="Sign in — OpenKarta Registry">
  <h1>Sign in</h1>
  <p>Sign in with a magic link or your GitHub account.</p>

  <h2>Magic link</h2>
  <form id="magic">
    <input type="email" name="email" placeholder="you@example.com" required style="padding:6px 8px; min-width: 280px" />
    <button type="submit">Send link</button>
  </form>
  <div id="magic-msg" style="margin-top:8px"></div>

  <h2>GitHub</h2>
  <p><a class="button" href={`${apiBase}/auth/github/start`}><button>Continue with GitHub</button></a></p>

  <script>
    import { requestMagicLink } from '../lib/api.ts';
    const $ = (id) => document.getElementById(id);
    $('magic').addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const email = String(fd.get('email') ?? '');
      $('magic-msg').textContent = 'Sending…';
      try {
        await requestMagicLink(email);
        $('magic-msg').className = 'success';
        $('magic-msg').textContent = 'If that account exists, a sign-in link is on its way.';
      } catch (err) {
        $('magic-msg').className = 'error';
        $('magic-msg').textContent = err.message ?? 'Failed to send link';
      }
    });
  </script>
</BaseLayout>
