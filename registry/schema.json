{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openkarta.org/registry/schema.json",
  "title": "OpenKarta Registry",
  "description": "Static, version-controlled list of OpenKarta-conformant agents. Stage 1 of the registry roadmap (Plan 08 will replace this with a hosted query service).",
  "type": "object",
  "required": ["version", "updated", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "const": "0.1" },
    "updated": { "type": "string", "format": "date" },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/Agent" }
    }
  },
  "$defs": {
    "Agent": {
      "type": "object",
      "required": ["agentId", "displayName", "baseUrl", "tier", "supportedItemTypes", "addedAt"],
      "properties": {
        "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "manifestUrl": { "type": "string", "format": "uri" },
        "tier": { "enum": ["lite", "http", "agentic"] },
        "supportedItemTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["product", "stay", "flight", "bus", "service"] }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["country"],
            "properties": {
              "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
              "city": { "type": "string" },
              "pincodes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "publicKey": {
          "type": ["string", "null"],
          "description": "Base64-encoded public key used to verify signed updates from this agent."
        },
        "badgeUrl": {
          "type": ["string", "null"],
          "description": "URL to the agent's signed conformance badge JSON."
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "addedAt": { "type": "string", "format": "date" },
        "verified": {
          "type": "boolean",
          "description": "Set by maintainers after the agent passes the conformance harness against its public baseUrl."
        }
      },
      "additionalProperties": false
    }
  }
}
